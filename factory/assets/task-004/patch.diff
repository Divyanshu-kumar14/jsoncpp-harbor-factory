+// RFC 7386 JSON Merge Patch.
+void Value::mergePatch(const Value& patch) {
+  if (&patch == this) {
+    // Iterating a patch that aliases the target would invalidate iterators.
+    Value copy(patch);
+    mergePatch(copy);
+    return;
+  }
+  if (!patch.isObject()) {
+    *this = patch;
+    return;
+  }
+  if (!isObject())
+    *this = Value(objectValue);
+  for (auto it = patch.begin(); it != patch.end(); ++it) {
+    const String key = it.name();
+    if (it->isNull())
+      removeMember(key);
+    else
+      (*this)[key].mergePatch(*it);
+  }
+}
