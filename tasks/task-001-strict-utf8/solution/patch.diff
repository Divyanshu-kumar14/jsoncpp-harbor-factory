+// Length in bytes of the well-formed UTF-8 sequence starting at `s`, or 0 if
+// the sequence is malformed (RFC 3629). `avail` bytes are readable from `s`.
+size_t utf8SequenceLength(const unsigned char* s, size_t avail) {
+  const unsigned char lead = s[0];
+  if (lead < 0x80)
+    return 1;
+
+  size_t len = 0;
+  unsigned char secondLo = 0x80;
+  unsigned char secondHi = 0xBF;
+  if (lead >= 0xC2 && lead <= 0xDF) {
+    len = 2;
+  } else if (lead >= 0xE0 && lead <= 0xEF) {
+    len = 3;
+    if (lead == 0xE0)
+      secondLo = 0xA0; // overlong 3-byte form
+    else if (lead == 0xED)
+      secondHi = 0x9F; // UTF-16 surrogate half
+  } else if (lead >= 0xF0 && lead <= 0xF4) {
+    len = 4;
+    if (lead == 0xF0)
+      secondLo = 0x90; // overlong 4-byte form
+    else if (lead == 0xF4)
+      secondHi = 0x8F; // code point above U+10FFFF
+  } else {
+    return 0; // continuation byte, overlong lead, or invalid lead
+  }
+
+  if (avail < len)
+    return 0; // truncated sequence
+  if (s[1] < secondLo || s[1] > secondHi)
+    return 0;
+  for (size_t i = 2; i < len; ++i) {
+    if (s[i] < 0x80 || s[i] > 0xBF)
+      return 0;
+  }
+  return len;
+}
