+namespace {
+// RFC 8259, Section 6: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
+bool isStrictJsonNumber(const char* begin, const char* end) {
+  const char* p = begin;
+  if (p == end)
+    return false;
+  if (*p == '-')
+    ++p;
+  if (p == end)
+    return false;
+  if (*p == '0') {
+    ++p;
+  } else if (*p >= '1' && *p <= '9') {
+    while (p != end && *p >= '0' && *p <= '9')
+      ++p;
+  } else {
+    return false;
+  }
+  if (p != end && *p == '.') {
+    ++p;
+    if (p == end || *p < '0' || *p > '9')
+      return false;
+    while (p != end && *p >= '0' && *p <= '9')
+      ++p;
+  }
+  if (p != end && (*p == 'e' || *p == 'E')) {
+    ++p;
+    if (p != end && (*p == '+' || *p == '-'))
+      ++p;
+    if (p == end || *p < '0' || *p > '9')
+      return false;
+    while (p != end && *p >= '0' && *p <= '9')
+      ++p;
+  }
+  return p == end;
+}
+} // namespace
+
 bool OurReader::decodeNumber(Token& token, Value& decoded) {
+  if (features_.strictNumbers_ &&
+      !isStrictJsonNumber(token.start_, token.end_))
+    return addError("'" + String(token.start_, token.end_) +
+                        "' is not a valid JSON number.",
+                    token);
